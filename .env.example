# ================================================================
# .env.example — Template for LMS-ITS PERKESO
# Salin fail ini sebagai .env dan isi dengan nilai sebenar
# ================================================================

# --- Supabase PostgreSQL (Production) ---
# Dapatkan dari: Supabase Dashboard → Settings → Database
#
# Format Connection Pooler (disyorkan - IPv4):
# postgresql://postgres.[PROJECT_REF]:[URL_ENCODED_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# Format Direct Connection (IPv6 sahaja):
# postgresql://postgres:[URL_ENCODED_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
#
# Nota: Jika kata laluan mengandungi '@', tukarkan kepada '%40' (URL-encoded)

DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[URL_ENCODED_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# --- Supabase Project Metadata ---
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_PROJECT_REF=[PROJECT_REF]
SUPABASE_PUBLISHABLE_KEY=[YOUR_PUBLISHABLE_KEY]

# --- Untuk pembangunan tempatan (SQLite fallback) ---
# Buat fail .env.local dengan:
# DATABASE_URL=file:/home/z/my-project/db/custom.db
